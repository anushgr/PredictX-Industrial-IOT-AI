SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# NVIDIA NIM setup (OpenAI-compatible endpoint)
NIM_API_KEY=replace-with-your-nim-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct

# MQTT ingest settings
MQTT_ENABLED=true
MQTT_HOST=805bdf7166664409a14daa5bf806ef48.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USE_WEBSOCKET=false
MQTT_WS_PORT=8884
MQTT_USERNAME=replace-with-mqtt-username
MQTT_PASSWORD=replace-with-mqtt-password
MQTT_TOPIC=predictx/machines/+/sensors/+
MQTT_QOS=1
MQTT_KEEPALIVE=60

# Aggregation settings
AGGREGATION_WINDOW_SIZE=10
OUTLIER_IQR_MULTIPLIER=1.5

# Supabase storage settings
SUPABASE_URL=https://jfhnigjrmzcamxgdaohq.supabase.co
SUPABASE_KEY=replace-with-service-role-key
SUPABASE_TABLE=sensor_aggregates
SUPABASE_RAW_TABLE=sensor_raw_records
SUPABASE_TIMEOUT_SECONDS=10

# Supabase direct Postgres connection settings for running table setup scripts.
# You can use either these individual fields or a DATABASE_URL.
# 
# For transaction pooler (recommended): use pooler.supabase.com on port 6543
# For session pooler: use pooler.supabase.com on port 6543
# For direct connection: use db.supabase.co on port 5432
#
# If your password contains special characters like '@', use URL encoding:
#   @ becomes %40
#   Example: password "Anush@123" becomes "Anush%40123" in the URL
#
# DATABASE_URL example with transaction pooler and URL-encoded password:
# postgresql://postgres.PROJECT_ID:PASSWORD_URL_ENCODED@aws-1-REGION.pooler.supabase.com:6543/postgres

SUPABASE_DB_HOST=db.jfhnigjrmzcamxgdaohq.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-with-database-password

# Transaction Pooler DATABASE_URL (replace PASSWORD_URL_ENCODED with your actual encoded password)
DATABASE_URL=postgresql://postgres.jfhnigjrmzcamxgdaohq:Anushgr%40123@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
